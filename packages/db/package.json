{
  "name": "@lfstats/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./lib/images": "./src/lib/images.ts",
    "./lib/team-logos": "./src/lib/team-logos.ts",
    "./lib/player-pictures": "./src/lib/player-pictures.ts",
    "./analytics": "./src/analytics.ts",
    "./lib/tdf": "./src/lib/tdf.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "migrate-legacy-comp": "tsx --env-file=.env src/scripts/migrate-legacy-competition.ts",
    "migrate-legacy-penalties": "tsx --env-file=.env src/scripts/migrate-legacy-penalties.ts",
    "reset-arena-penalties": "tsx --env-file=.env src/scripts/reset-arena-penalty-deductions.ts",
    "migrate-legacy-pdf-games": "tsx --env-file=.env src/scripts/migrate-legacy-pdf-games.ts",
    "migrate-legacy-pdf-competition": "tsx --env-file=.env src/scripts/migrate-legacy-pdf-competition.ts",
    "fix-legacy-pdf-start-times": "tsx --env-file=.env src/scripts/fix-legacy-pdf-start-times.ts",
    "legacy-pdf-report": "tsx --env-file=.env src/scripts/legacy-pdf-report.ts",
    "legacy-variance": "tsx --env-file=.env src/scripts/legacy-variance-report.ts",
    "backfill-solo-format": "tsx --env-file=.env src/scripts/backfill-solo-format.ts",
    "backfill-competition-category": "tsx --env-file=.env src/scripts/backfill-competition-category.ts",
    "rating-bakeoff": "tsx --env-file=.env src/scripts/rating/bakeoff.ts",
    "recalc-rating": "tsx --env-file=.env src/scripts/recalc-rating.ts",
    "lint": "oxlint",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1156.0",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
